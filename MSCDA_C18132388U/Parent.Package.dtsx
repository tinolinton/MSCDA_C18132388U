      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D6A461D7-D163-4C4B-BFB4-2BE97CBC4F53}"
          SQLTask:SqlStatementSource="INSERT INTO config_tbl&#xA;SELECT 'Parent.Package.dtsx', GETDATE(), 1;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Exec Count"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CDC93EE6-F5E1-48E4-BEB7-733F0323E286}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Exec Count"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{D6A461D7-D163-4C4B-BFB4-2BE97CBC4F53}"
          SQLTask:SqlStatementSource="declare @cnt int&#xA;IF  not EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[config_tbl]') AND type in (N'U'))&#xA;create table config_tbl(Id int identity, PackageName nvarchar(100) NOT NULL, Dated date, ExecutionCount int)&#xA;  set @cnt = (select sum(ExecutionCount) from config_tbl where PackageName = 'Parent.Package.dtsx' and Dated = cast(GETDATE() as date))&#xA;  set @cnt = ISNULL(@cnt, 0)&#xA;  select @cnt"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::ExecutionCount" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
